generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  googleId  String   @unique
  firstName String?
  lastName  String?
  picture   String?

  isActive Boolean @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  pets          Pet[]
  sitterProfile SitterProfile?

  ownerBookings Booking[] @relation("OwnerBookings")

  @@map("users")
}

model SitterProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  description     String?
  experienceYears Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  sitterServices SitterService[]
  bookings       Booking[]       @relation("SitterProfileBookings")

  @@map("sitter_profiles")
}

model SitterService {
  id              Int         @id @default(autoincrement())
  sitterProfileId Int

  type        ServiceType
  price       Decimal     @db.Decimal(10, 2)
  durationMin Int?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sitterProfile SitterProfile @relation(fields: [sitterProfileId], references: [id])
  bookings      Booking[]

  @@map("sitter_services")

  @@index([sitterProfileId])
}

model Booking {
  id              Int @id @default(autoincrement())

  ownerId         Int
  sitterProfileId Int?
  petId           Int
  sitterServiceId Int?

  // Snapshot of price at booking creation time
  bookingPrice Decimal @default(0) @db.Decimal(10, 2)

  startTime DateTime
  endTime   DateTime

  status BookingStatus @default(PENDING)

  ownerNotes  String?
  sitterNotes String?

  acceptedAt  DateTime?
  cancelledAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User          @relation("OwnerBookings", fields: [ownerId], references: [id])
  sitterProfile SitterProfile? @relation("SitterProfileBookings", fields: [sitterProfileId], references: [id])
  pet           Pet           @relation(fields: [petId], references: [id])
  sitterService SitterService? @relation(fields: [sitterServiceId], references: [id])

  @@map("bookings")

  @@index([ownerId])
  @@index([sitterProfileId])
  @@index([petId])
  @@index([sitterServiceId])

  // Owner booking history
  @@index([ownerId, createdAt])

  // Sitter dashboard queries
  @@index([sitterProfileId, status])

  // Booking conflict detection
  @@index([sitterProfileId, startTime, endTime])
}

model Pet {
  id      Int @id @default(autoincrement())
  ownerId Int

  name  String
  type  PetType
  breed String?
  age   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id])
  bookings Booking[]

  @@map("pets")

  @@index([ownerId])
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum ServiceType {
  WALKING
  DAYCARE
  HOME_VISIT
  OVERNIGHT
}

enum PetType {
  DOG
  CAT
  BIRD
  OTHER
}