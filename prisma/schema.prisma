// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  googleId  String   @unique
  firstName String?
  lastName  String?
  picture   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pets           Pet[]
  sitterProfile  SitterProfile?
  ownerBookings  Booking[] @relation("OwnerBookings")
  sitterBookings Booking[] @relation("SitterBookings")

  @@map("users")
}

model SitterProfile {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  description        String?
  experienceYears    Int?
  hourlyRate         Decimal?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  services Service[]

  @@map("sitter_profiles")
}

model Service {
  id               Int      @id @default(autoincrement())
  sitterProfileId  Int
  type             String
  price            Decimal
  duration         Int?
  description      String?

  sitterProfile SitterProfile @relation(fields: [sitterProfileId], references: [id])
  bookings      Booking[]

  @@map("services")
}

model Booking {
  id        Int           @id @default(autoincrement())
  ownerId   Int
  sitterId  Int
  petId     Int
  serviceId Int

  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User    @relation("OwnerBookings", fields: [ownerId], references: [id])
  sitter  User    @relation("SitterBookings", fields: [sitterId], references: [id])
  pet     Pet     @relation(fields: [petId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@map("bookings")
}

model Pet {
  id        Int       @id @default(autoincrement())
  ownerId   Int
  name      String
  type      String?
  breed     String?
  age       Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id])
  bookings Booking[]

  @@map("pets")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}