generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  googleId  String   @unique
  firstName String?
  lastName  String?
  picture   String?

  isActive Boolean @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  pets          Pet[]
  sitterProfile SitterProfile?

  ownerBookings Booking[] @relation("OwnerBookings")
  reviews       Review[]

  @@map("users")
}

model SitterProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  description     String?
  experienceYears Int?
  timezone        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User                         @relation(fields: [userId], references: [id])
  sitterServices        SitterService[]
  bookings              Booking[]                    @relation("SitterProfileBookings")
  weeklyAvailability    WeeklyAvailability[]
  availabilityOverrides AvailabilityOverride[]

  @@map("sitter_profiles")
}

model SitterService {
  id                Int         @id @default(autoincrement())
  sitterProfileId   Int

  type              ServiceType
  petTypes          PetType[]

  price             Decimal     @db.Decimal(10, 2)
  durationMin       Int?
  description       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sitterProfile SitterProfile @relation(fields: [sitterProfileId], references: [id])
  bookings      Booking[]

  @@map("sitter_services")

  @@index([sitterProfileId])
  @@unique([sitterProfileId, type])
}

/// DB CHECK: endTime > startTime.
model Booking {
  id              Int @id @default(autoincrement())

  ownerId         Int
  petId           Int
  sitterProfileId Int?
  sitterServiceId Int?

  price Decimal @default(0) @db.Decimal(10, 2)

  startTime DateTime @db.Timestamptz(3)
  endTime   DateTime @db.Timestamptz(3)

  status BookingStatus @default(PENDING)

  ownerNotes  String?
  sitterNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User          @relation("OwnerBookings", fields: [ownerId], references: [id])
  sitterProfile SitterProfile? @relation("SitterProfileBookings", fields: [sitterProfileId], references: [id])
  pet           Pet           @relation(fields: [petId], references: [id])
  sitterService SitterService? @relation(fields: [sitterServiceId], references: [id])
  reviews       Review[]

  @@map("bookings")

  @@index([ownerId])
  @@index([sitterProfileId])
  @@index([petId])
  @@index([sitterServiceId])

  // Owner booking history
  @@index([ownerId, createdAt])

  // Sitter dashboard queries
  @@index([sitterProfileId, status])
}

model Pet {
  id      Int @id @default(autoincrement())
  ownerId Int

  name             String
  type             PetType
  breed            String
  birthDate        DateTime           @db.Date
  coat             PetCoat
  weightKg         Decimal            @db.Decimal(6, 2)
  generalHealth    PetGeneralHealth
  temperament      PetTemperament
  gender           PetGender
  neuteredSpayed   Boolean
  description      String?
  vetName          String?
  vetPhone         String?
  vetAddress       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id])
  bookings Booking[]

  @@map("pets")

  @@index([ownerId])
}

model Review {
  id         Int      @id @default(autoincrement())
  bookingId  Int
  reviewerId Int

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id])
  reviewer User    @relation(fields: [reviewerId], references: [id])

  @@unique([bookingId, reviewerId])
  @@index([reviewerId])
  @@map("reviews")
}

/// Working hours in the sitter's local time. Not used for OVERNIGHT.
/// weekday is ISO (Monday = 1 ... Sunday = 7), same as Postgres ISODOW and Luxon.
/// DB CHECK: 1 <= weekday <= 7; 0 <= startMinute < endMinute <= 1440.
/// DB EXCLUDE: windows of the same sitter and weekday must not overlap (touching ends are allowed).
model WeeklyAvailability {
  id              Int     @id @default(autoincrement())
  sitterProfileId Int
  weekday         Int
  startMinute     Int
  endMinute       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sitterProfile SitterProfile @relation(fields: [sitterProfileId], references: [id], onDelete: Cascade)

  @@index([sitterProfileId, weekday])
  @@map("weekly_availability")
}

/// One-off exceptions as absolute instants, applied to all services.
/// BLOCK always wins over OPEN. DB CHECK: endTime > startTime.
model AvailabilityOverride {
  id              Int              @id @default(autoincrement())
  sitterProfileId Int
  startTime       DateTime         @db.Timestamptz(3)
  endTime         DateTime         @db.Timestamptz(3)
  type            DateOverrideType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sitterProfile SitterProfile @relation(fields: [sitterProfileId], references: [id], onDelete: Cascade)

  @@index([sitterProfileId, endTime])
  @@map("availability_overrides")
}

enum DateOverrideType {
  BLOCK
  OPEN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum ServiceType {
  WALKING
  DAYCARE
  HOME_VISIT
  OVERNIGHT
}

enum PetType {
  DOG
  CAT
  BIRD
  OTHER
}

enum PetCoat {
  SHORT
  MEDIUM
  LONG
}

enum PetGeneralHealth {
  HEALTHY
  NORMAL
  NEEDS_ADDITIONAL_CARE
}

enum PetTemperament {
  PASSIVE
  ENERGETIC
  ASSERTIVE
  PASSIVE_AGGRESSIVE
  AGGRESSIVE
}

enum PetGender {
  MALE
  FEMALE
}
